  function adbriteReplaceAbsent(adbriteElName, adblock, newWidth, newHeight){
    var adbriteEl = document.getElementById(adbriteElName);
    if( adbriteEl ){
      adloggerInc("adbriteDisplay_"+adbriteElName, adbriteEl.innerHTML);
      var present=false;
      var spans = adbriteEl.getElementsByTagName("span");
      for( var i in spans ){
        if( spans[i].className && spans[i].className.indexOf("adText")!=-1 ){
          if( spans[i].innerHTML.toLowerCase().indexOf('adbrite')==-1 ){
            present=true;
            adloggerInc("adbritePresent_"+adbriteElName);
